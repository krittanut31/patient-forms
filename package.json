{
  "name": "patient-forms",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n web,socket -c cyan,magenta \"npm:dev:web\" \"npm:dev:socket\"",
    "dev:web": "npm run dev --workspace @patient-forms/web",
    "dev:socket": "npm run dev --workspace @patient-forms/socket-server",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
